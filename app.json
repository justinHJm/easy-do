{
  "expo": {
    "name": "easy-do",
    "slug": "easy-do",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/characters/easydo-base.png",
    "scheme": "easydo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.justinhjm.easydo",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/characters/easydo-base.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df7f31c5-0bdb-4319-b6ad-b863c142853c"
      }
    },
    "owner": "ceba77"
  }
}
