{
  "expo": {
    "name": "easy-do",
    "slug": "easy-do",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/characters/easydo-base.png",
    "scheme": "easydo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.justinhjm.easydo",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodoWidget",
              "label": "오늘 Todo",
              "previewImage": "./assets/widgets/today-todo-preview.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2
            },
            {
              "name": "AllTodoWidget",
              "label": "전체 Todo",
              "previewImage": "./assets/widgets/all-todo-preview.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/characters/easydo-base.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df7f31c5-0bdb-4319-b6ad-b863c142853c"
      }
    },
    "owner": "ceba77"
  }
}
